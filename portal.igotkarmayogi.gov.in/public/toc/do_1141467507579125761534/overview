  <!--
    Third-party widgets, attached once the page has loaded and the browser is idle.

    Previously UserWay was fetched TWICE - once by a parser-blocking script tag and
    again by an inline injector that appended an identical tag to the body. Both ran
    during initial page load, so widget.js (which builds its own iframe) competed with
    the app bundles for bandwidth and main-thread time before first render.

    Nothing here is needed for first paint:
      - UserWay  : viewer.component.ts only reads the `.userway_p2` element inside a
                   setTimeout, so it does not need the widget present at bootstrap.
      - Zoho     : jqueryandencoder.js only backs the web-to-case form handler.

    The `timeout` on requestIdleCallback caps the delay so the accessibility widget
    still appears promptly on a busy main thread; it is deliberately NOT gated behind
    user interaction, which would put it out of reach of the users who need it.
    To override UserWay defaults (position, size, language, colour, type, mobile,
    trigger), add the relevant data-* key to the `attrs` object below.
  -->
  <script>
    (function () {
      var WIDGETS = [
        {
          // No `integrity` here, deliberately. cdn.userway.org/widget.js is an unversioned
          // ~1.7 KB bootstrap that UserWay rewrites at will, so any pinned hash goes stale
          // and the browser then blocks the script outright - which is exactly what the
          // previously committed sha384-Z3p55G... hash was already doing. The widget only
          // ever loaded because the old inline injector alongside it carried no integrity
          // attribute. Pin a hash here again only if you also self-host a fixed copy.
          src: 'https://cdn.userway.org/widget.js',
          attrs: { 'data-account': 'pam3S93IQ7' },
        },
        {
          src: 'https://js.zohostatic.in/support/app/js/jqueryandencoder.ffa5afd5124fbedceea9.js',
          integrity: 'sha384-WxjccFdarXj9qC3CXtilb+x2qSQA3CMFOjT6vA0CkfexBVqYRAISERxH45f5VnmM',
        },
      ]

      function attachWidgets() {
        WIDGETS.forEach(function (widget) {
          var el = document.createElement('script')
          el.src = widget.src
          el.async = true
          if (widget.integrity) {
            el.integrity = widget.integrity
            el.crossOrigin = 'anonymous'
          }
          Object.keys(widget.attrs || {}).forEach(function (key) {
            el.setAttribute(key, widget.attrs[key])
          })
          document.body.appendChild(el)
        })
      }

      var attached = false
      function attachOnce() {
        if (attached) { return }
        attached = true
        attachWidgets()
      }

      function scheduleWidgets() {
        if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(attachOnce, { timeout: 3000 })
        } else {
          window.setTimeout(attachOnce, 1500)
        }
      }

      if (document.readyState === 'complete') {
        scheduleWidgets()
      } else {
        window.addEventListener('load', scheduleWidgets, { once: true })
      }

      // Hard backstop, independent of `load`. The load event waits on every subresource
      // (Google Fonts, the Zoho and Netcore CDNs), so a single hung third-party request
      // would otherwise strand the accessibility widget indefinitely - the idle timeout
      // above cannot help, because its clock only starts once `load` has fired.
      window.setTimeout(attachOnce, 5000)
    })()
  </script>
