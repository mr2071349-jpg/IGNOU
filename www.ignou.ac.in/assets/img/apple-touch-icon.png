        $(document).ready(function () {
            var pageLang = $("html").attr("lang");
            //console.log(pageLang);
            if(pageLang=="hi"){
                $('span:contains("घर")').text("होम");
            }

            $.getJSON("/api/menu/Top", function (data) {
                $.each(data, function (key, value) {
                    if (value[2] == 'Announcements') {
                        $("#topMenu").append('<li class="topMenu" class="nav-item">' + '<a class="nav-link" href="/pages/' + value[0] + '"><span>' + value[1] + ' ' + value[2] +
                            '<label class="newLink1 badge badge-pill" style="margin: -14px -11px; position: absolute;">New</label></span></a>' +

                            '</li>');
                    } else {
                        $("#topMenu").append('<li class="topMenu" class="nav-item">' + '<a class="nav-link" href="/pages/' + value[0] + '"><span id=' + value[2] + '>' + value[1] + ' ' + value[2] + '</span></a>' +
                            '</li>');
                    }
                    

                    
                })
            })
setTimeout(function() {
        // Find the specific bad translation
        $('span:contains("घर")').text("होम");
    }, 0); // Adjust delay based on load speed

        });

     $(window).load(function() {
