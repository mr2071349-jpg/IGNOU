{
  "headers": [
    {
      "source": "/(.*)/([^.]+)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/www.ignou.ac.in/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/pages/:path*",
      "destination": "/www.ignou.ac.in/pages/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/www.ignou.ac.in/images/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/www.ignou.ac.in/assets/:path*"
    },
    {
      "source": "/webjars/:path*",
      "destination": "/www.ignou.ac.in/webjars/:path*"
    }
  ]
}
