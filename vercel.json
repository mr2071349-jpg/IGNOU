{
  "headers": [
    {
      "source": "/(.*)/([^.]+)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/www.ignou.ac.in/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/menu/Top",
      "destination": "/api/menu/Top.json"
    },
    {
      "source": "/pages/:path*",
      "destination": "/www.ignou.ac.in/pages/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/www.ignou.ac.in/images/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/www.ignou.ac.in/assets/:path*"
    },
    {
      "source": "/webjars/:path*",
      "destination": "/www.ignou.ac.in/webjars/:path*"
    },
    {
      "source": "/announcement/:path*",
      "destination": "/www.ignou.ac.in/announcement/:path*"
    },
    {
      "source": "/faq/:path*",
      "destination": "/www.ignou.ac.in/faq/:path*"
    },
    {
      "source": "/ignou/:path*",
      "destination": "/www.ignou.ac.in/ignou/:path*"
    },
    {
      "source": "/schools/:path*",
      "destination": "/www.ignou.ac.in/schools/:path*"
    },
    {
      "source": "/userfiles/:path*",
      "destination": "/www.ignou.ac.in/userfiles/:path*"
    },
    {
      "source": "/viewFile/:path*",
      "destination": "/www.ignou.ac.in/viewFile/:path*"
    }
  ]
}
