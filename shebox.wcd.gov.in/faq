<script>
$(document).ready(function () {

    var $accessBtn = $('.accessibility-btn');
    var $panel = $('#accessibilityPanel');
    var $closeBtn = $('.accessibility-close');

    var lastFocusedElement = null;


    /* =====================================================
       OPEN ACCESSIBILITY PANEL
    ===================================================== */

    $accessBtn.on('click', function (e) {

        e.preventDefault();

        lastFocusedElement = this;

        $panel
            .addClass('is-open')
            .attr('aria-hidden', 'false');

        $accessBtn.attr('aria-expanded', 'true');

        /* Move keyboard focus inside panel */
        setTimeout(function () {
            $closeBtn.focus();
        }, 50);

    });


    /* =====================================================
       CLOSE FUNCTION
    ===================================================== */

    function closeAccessibilityPanel() {

        $panel
            .removeClass('is-open')
            .attr('aria-hidden', 'true');

        $accessBtn.attr('aria-expanded', 'false');

        /* Return focus to accessibility button */
        if (lastFocusedElement) {
            $(lastFocusedElement).focus();
        }

    }


    /* =====================================================
       CLOSE BUTTON
    ===================================================== */

    $closeBtn.on('click', function () {

        closeAccessibilityPanel();

    });


    /* =====================================================
       ESCAPE KEY
    ===================================================== */

    $(document).on('keydown', function (e) {

        if (e.key === 'Escape' || e.keyCode === 27) {

            if ($panel.hasClass('is-open')) {

                e.preventDefault();

                closeAccessibilityPanel();

            }

        }

    });


    /* =====================================================
       FOCUS TRAP
    ===================================================== */

    $panel.on('keydown', function (e) {

        if (e.key !== 'Tab' && e.keyCode !== 9) {
            return;
        }


        var $focusable = $panel.find(
            'button:not([disabled]),' +
            '[href]:not([disabled]),' +
            'input:not([disabled]),' +
            'select:not([disabled]),' +
            'textarea:not([disabled]),' +
            '[tabindex]:not([tabindex="-1"])'
        );


        var firstElement = $focusable[0];

        var lastElement = $focusable[$focusable.length - 1];


        /* Shift + Tab */

        if (e.shiftKey) {

            if (document.activeElement === firstElement) {

                e.preventDefault();

                lastElement.focus();

            }

        }


        /* Normal Tab */

        else {

            if (document.activeElement === lastElement) {

                e.preventDefault();

                firstElement.focus();

            }

        }

    });

});
</script>

  
  <script type="text/javascript">
    $(document).ready(function () {

        $('#takePledge').on('shown.bs.modal', function () {
            loadStates();
        });

        $('#pledge-btn1').on('click', function () {
        // alert("sdfgsdf");
            savePledgeData();
        });
        $('#pledge-btn2').on('click', function () {
            savePledgeData();
        });

    });


    function savePledgeData() {
        $.ajax({
            url: "https://shebox.wcd.gov.in/savePledgeData",
            type: "GET",
            dataType: "json",
            success: function(response) {

                if (response.status) {

                    swal({
                        title: "Success",
                        text: response.message,
                        type: "success"
                    }, function() {
                        window.location.href = response.redirect;
                    });

                } else {

                    swal({
                        title: "Warning",
                        text: response.message,
                        type: "warning"
                    }, function() {
                        window.location.href = response.redirect;
                    });
                }
            },
            error: function() {
                Swal({
                    title: "Error",
                    text: "Something went wrong. Please try again.",
                    type: "error"
                });
            }
        });
    }

    function loadStates()
    {
        $.ajax({
            url: "https://shebox.wcd.gov.in/getStates",
            type: "GET",
            dataType: "json",
            success: function(response)
            {
                var html = '<option value="">-- Select State --</option>';

                $.each(response, function(index, row){

                    html += '<option value="'+row.stcode+'">'+row.stname+'</option>';

                });

                $('#statepleadge').html(html);
            }
        });
    }

    function getDistricts(state_id)
    {
        if(state_id === "")
        {
            $('#district_id_pledge').html('<option value="">-- Select District --</option>');
            return;
        }

        $.ajax({
            url: "https://shebox.wcd.gov.in/getDistricts",
            type: "POST",
            data: { state_id: state_id },
            dataType: "json",
            success: function(response)
            {
                console.log("District response:", response);

                var html = '<option value="">-- Select District --</option>';

                $.each(response, function(i, row){
                    html += '<option value="'+row.dtcode+'">'+row.dtname+'</option>';
                });

                $('#district_id_pledge').html(html);
            },
            error: function(xhr){
                console.log("District error:", xhr.responseText);
            }
        });
    }
</script>



<script type="text/javascript">

    $('#submitPledge').on('click', function(e){

        e.preventDefault();

        // Purane error clear karo
        $('.text-danger').html('');

        var name = $('#name').val().trim();
        var mobile = $('#mobile').val().trim();
        var language = $('#language').val();
        var state = $('#statepleadge').val();
        var district = $('#district_id_pledge').val();
        //var district = $('#district_id_pledge').val();

        

        var isValid = true;

        if(name == ''){
            $('#name_err').html('Please enter name.');
            isValid = false;
        }

        if(mobile == ''){
            $('#mobile_err').html('Please enter mobile number.');
            isValid = false;
        } else if(!/^[0-9]{10}$/.test(mobile)){
            $('#mobile_err').html('Please enter a valid 10 digit mobile number.');
            isValid = false;
        }

        if(language == ''){
            $('#language_err').html('Please select language.');
            isValid = false;
        }

        if(state == ''){
            $('#state_err').html('Please select state.');
            isValid = false;
        }

        if(district == ''){
            $('#dist_err').html('Please select district.');
            isValid = false;
        }

        if(!isValid){
            return false;
        }

        $.ajax({
            url: "https://shebox.wcd.gov.in/savePledge",
            type: "POST",
            data: $('#pledgeForm').serialize(),
            dataType: "json",
            success: function(response)
            {
                if(response.status)
                {
                    window.location.href = response.redirect_url;
                }
                else
                {
                    swal("Error", response.message, "error");
                }
            },
            error: function() {
                swal("Error", "Something went wrong.", "error");
            }
        });
    });

</script>


<script>
    $(document).ready(function () {
    $(".safeText").on("keyup paste", function () {
        var value = $(this).val();

        // Remove everything except letters, numbers, and space
        var cleaned = value.replace(/[^a-zA-Z0-9 ]/g, "");

        if (value !== cleaned) {
        $("#error").text("Only alphanumeric characters are allowed");
        $(this).val(cleaned);
        } else {
        $("#error").text("");
        }
    });
    });
</script>

<script>
    $('input').on('keypress', function (e) {
        if ($(this).attr('type') == 'email') {
            script_remover_email(e);
        } else {
            if ($(this).attr('class') == "form-control number") {
                number_check(e);
            } else if ($(this).attr('class') == "alpha") {
                lettersOnly(e);
            } else {
                script_remover(e);
            }
        }
    });

    function lettersOnly(evt) {
        console.log(evt);
        evt = (evt) ? evt : event;
        var charCode = (evt.charCode) ? evt.charCode : ((evt.keyCode) ? evt.keyCode :
                ((evt.which) ? evt.which : 0));
        if (charCode > 32 && (charCode < 65 || charCode > 90) &&
                (charCode < 97 || charCode > 122)) {
            evt.preventDefault();
            return false;
        }
        return true;
    }


    $(document).ready(function () {
        $(".searchable_dropdown").select2();
        $('.tlClogo').bind('contextmenu', function (e) {
            return false;
        });

    });
  

    function script_remover_email(e) {
    var keyCode = e.keyCode || e.which;
    var allowedKeys = [8, 9, 46, 36, 35, 37, 39, 64, 190, 95, 45];  
    // Allowed: Backspace, Tab, Delete, Home, End, Left, Right, @, ., _, -

    var isLetterOrNumber = (keyCode >= 48 && keyCode <= 57) || // Numbers (0-9)
                            (keyCode >= 65 && keyCode <= 90) || // Uppercase letters (A-Z)
                            (keyCode >= 97 && keyCode <= 122); // Lowercase letters (a-z)

    var isAllowedSpecial = allowedKeys.includes(keyCode);

    var isBlockedSpecial = ['#', '$', '%', '^', '&', '*', '(', ')'].includes(e.key); 
    // Removed "-" from blocked list

    if (!isLetterOrNumber && !isAllowedSpecial) {
        e.preventDefault();
        return false;
    }

    if (isBlockedSpecial) {
        e.preventDefault();
        return false;
    }
 }


    $(document).ready(function () {
        $(".number").keydown(function (e) {
            // Allow: backspace, delete, tab, escape, enter and .
            if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110, 190]) !== -1 ||
                    // Allow: Ctrl+A, Command+A
                            (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                            // Allow: home, end, left, right, down, up
                                    (e.keyCode >= 35 && e.keyCode <= 40)) {
                        // let it happen, don't do anything
                        return;
                    }
                    // Ensure that it is a number and stop the keypress
                    if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                        e.preventDefault();
                    }
                });
    });

    function number_check(e) {
//              $(".number").keydown(function (e) {
