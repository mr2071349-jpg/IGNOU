<script>
document.addEventListener("DOMContentLoaded", function() {

    var acc = document.getElementsByClassName("accordion");

    // Initialize all accordions
    for (var i = 0; i < acc.length; i++) {
        var panel = acc[i].nextElementSibling;

        // Collapse all panels initially
        panel.style.maxHeight = "0px";
        acc[i].setAttribute("aria-expanded", "false");

        // Add ARIA attributes dynamically if not present
        if (!panel.id) {
            panel.id = "panel-" + i;
        }
        if (!acc[i].id) {
            acc[i].id = "accordion-" + i;
        }
        acc[i].setAttribute("aria-controls", panel.id);
        panel.setAttribute("role", "region");
        panel.setAttribute("aria-labelledby", acc[i].id);

        // Keyboard support (Enter / Space to toggle)
        acc[i].addEventListener("keydown", function(e) {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                this.click();
            }
        });
    }

    // Open first accordion by default
    if (acc.length > 0) {
        var firstAccordion = acc[0];
        var firstPanel = firstAccordion.nextElementSibling;
        firstAccordion.classList.add("active");
        firstPanel.style.maxHeight = firstPanel.scrollHeight + "px";
        firstAccordion.setAttribute("aria-expanded", "true");
    }

    // Click event for toggling
    for (var i = 0; i < acc.length; i++) {
        acc[i].addEventListener("click", function() {

            var isExpanded = this.getAttribute("aria-expanded") === "true";

            // Collapse all accordions
            for (var j = 0; j < acc.length; j++) {
                acc[j].classList.remove("active");
                acc[j].setAttribute("aria-expanded", "false");
                var panel = acc[j].nextElementSibling;
                panel.style.maxHeight = null;
            }

            // Toggle current accordion if it was collapsed
            if (!isExpanded) {
                this.classList.add("active");
                var panel = this.nextElementSibling;
                panel.style.maxHeight = panel.scrollHeight + "px";
                this.setAttribute("aria-expanded", "true");
            }
        });
    }

});
</script>