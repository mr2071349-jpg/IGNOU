        if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110, 190]) !== -1 ||
                // Allow: Ctrl+A, Command+A
                        (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                        // Allow: home, end, left, right, down, up
                                (e.keyCode >= 35 && e.keyCode <= 40)) {
                    // let it happen, don't do anything
                    return;
                }
                // Ensure that it is a number and stop the keypress
                if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                    e.preventDefault();
                }
//                });
            }


            function readURL(input) {
                if (input.files && input.files[0]) {
                    if (input.files[0]['size'] > 120000) {
                        swal({
                            title: "Please upload image with 120kb or less.",
                            text: "",
                            type: "error",
                        });
                        e.preventDefault();
                    } else if (input.files[0]['type'] != 'image/jpeg' && input.files[0]['type'] != 'image/png') {
                        swal({
                            title: "Please upload image with png/jpg format only.",
                            text: "",
                            type: "error",
                        });
                        //        alert('Please upload image with jpeg/png/jpg format only');
                        e.preventDefault();
                    }
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#previewHolder').attr('src', e.target.result);
                    }
                    reader.readAsDataURL(input.files[0]);
                } else {
                    alert('Please Upload Image');
                }
            }

            function readURL1(input) {
                if (input.files && input.files[0]) {
                    if (input.files[0]['size'] > 120000) {
                        swal({
                            title: "Please upload image with 120kb or less.",
                            text: "",
                            type: "error",
                        });
                        e.preventDefault();
                    } else if (input.files[0]['type'] != 'image/jpeg' && input.files[0]['type'] != 'image/png') {
                        swal({
                            title: "Please upload image with png/jpg format only.",
                            text: "",
                            type: "error",
                        });
                        //        alert('Please upload image with jpeg/png/jpg format only');
                        e.preventDefault();
                    }
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#previewHolder').attr('src', e.target.result);
                    }
                    reader.readAsDataURL(input.files[0]);
                } else {
                    alert('Please Upload Image');
                }
            }

            $("#filePhoto").change(function () {
                readURL1(this);
            });
</script>


<script>
            $(document).ready(function () {
                $('#hide_other').hide();
                $(".send_otp_sms").change(function (e) {
                    $('#private_form_submit').attr('disabled', 'disabled');
                    var number = $(this).val();
                    var otp_type  = $('#otp_type').val();
                     if (number.length == 10) {
                        var token = 'f9ca6325700cc7d236df31484dd76741'
                        $.ajax({
                            type: "POST",
                            url: "https://shebox.wcd.gov.in/index.php/getSMSOTP",
                            data: {number: number, token: token,otp_type:otp_type},
                            dataType: 'json',
                            success: function (response) {
                            //    console.log(response);
                                check_mobile_otp(number,otp_type);
                            }
                        });
                    } else if (number.length < 10 && number.length > 0) {
                        $('#phone_no').focus().css('border-color', 'red');
                        $('.j-multi-next-btn').attr('disabled', true);
                        e.preventDefault();
                    } else {
                        $('.j-multi-next-btn').removeAttr('disabled');
                    }
                });
            });

function check_mobile_otp(number, otp_type) {
    var last4 = number.slice(-4);
    var maskedMobile = "****" + last4;
    var csrfToken = 'f9ca6325700cc7d236df31484dd76741';

    let countdownHTML = `
        <div id='resend-timer' style='margin-top: 12px; font-size: 14px; color: #888;'>
            ⏳ Resend OTP in <span id='timer'>60</span> seconds
        </div>
    `;

    swal({
        title: "<div style='font-size: 22px; font-weight: bold;'>🔒 Verify Your Mobile Number</div>",
        text: `
            <div style='font-size: 15px; line-height: 1.8; text-align: left;'>
                Please enter the <strong>6-digit One-Time Password (OTP)</strong> sent to your registered mobile number: 
                <strong style='color: #333;'>(${maskedMobile})</strong><br><br>
                <span style='color: #d9534f; font-weight: bold;'>Note:</span> OTP is valid for <strong>10 minutes</strong> only.
                ${countdownHTML}
            </div>`,
        type: "input",
        html: true,
        inputPlaceholder: "Enter 6-digit OTP",
        inputValue: "",
        showCancelButton: false,
        closeOnConfirm: false,
        closeOnCancel: false,
        allowEscapeKey: false,
        allowOutsideClick: false,
    }, function (inputValue) {
        if (inputValue === false) return false;

        inputValue = inputValue.trim();

        if (inputValue === "") {
            swal.showInputError("Please enter the OTP.");
            return false;
        }

        if (!/^\d{6}$/.test(inputValue)) {
            swal.showInputError("Please enter a valid 6-digit numeric OTP.");
            return false;
        }

        $.ajax({
            type: "POST",
            url: "https://shebox.wcd.gov.in/index.php/checkOTPValid",
            data: { number: number, otp_type: otp_type, entered_otp: inputValue, token: csrfToken },
            dataType: 'json',
            success: function (res) {
                swal({
                    title: "✅ Mobile Verified",
                    text: "Your mobile number has been successfully authenticated.",
                    icon: "success",
                    button: {
                        text: "Continue",
                        className: "custom-swal-btn"
                    },
                });

                $('.j-multi-next-btn, .popup-otp, #private_form_submit').removeAttr('disabled');
                $('#hide_other').show();
                // $('.send_otp_sms').prop('disabled', true);
                $('#mobile-verified-icon').fadeIn();
            },
            error: function (xhr) {
                if (xhr.status === 403) {
                    const res = JSON.parse(xhr.responseText);
                    swal.showInputError(res.message);
                } else {
                    alert("Unexpected error occurred.");
                }
            }
        });
    });

    // Countdown timer & Resend logic
    let seconds = 60;
    const timerInterval = setInterval(() => {
        seconds--;
        $('#timer').text(seconds);

        if (seconds <= 0) {
            clearInterval(timerInterval);

            $('#resend-timer').html(`
                <a href="#" id="resendOtpBtn" style="display: inline-block; font-size: 15px; font-weight: 600; color: #007bff; text-decoration: underline; margin-top: 8px;">
                    🔁 Resend OTP
                </a>
            `);

            $('#resendOtpBtn').on('click', function (e) {
                e.preventDefault();
                $('#resend-timer').html("🔄 Resending OTP...");

                $.ajax({
                    type: "POST",
                    url: "https://shebox.wcd.gov.in/index.php/getSMSOTP",
                    data: { number: number, otp_type: otp_type, token: csrfToken },
                    success: function () {
                        $('#resend-timer').html(`<span style="color: #28a745;">✅ OTP has been resent. Please check your mobile.</span>`);
                        
                        // Restart the timer
                        seconds = 60;
                        $('#resend-timer').html(`
                            ⏳ Resend OTP in <span id="timer">60</span> seconds
                        `);
                        startTimer();
                    },
                    error: function () {
                        $('#resend-timer').html(`<span style="color: #d9534f;">❌ Failed to resend OTP. Try again later.</span>`);
                    }
                });
            });
        }
    }, 1000);

    function startTimer() {
        const interval = setInterval(() => {
            seconds--;
            $('#timer').text(seconds);
            if (seconds <= 0) clearInterval(interval);
        }, 1000);
    }
}



