    function savePledgeData() {
        $.ajax({
            url: "https://shebox.wcd.gov.in/savePledgeData",
            type: "GET",
            dataType: "json",
            success: function(response) {

                if (response.status) {

                    swal({
                        title: "Success",
                        text: response.message,
                        type: "success"
                    }, function() {
                        window.location.href = response.redirect;
                    });

                } else {

                    swal({
                        title: "Warning",
                        text: response.message,
                        type: "warning"
                    }, function() {
                        window.location.href = response.redirect;
                    });
                }
            },
            error: function() {
                Swal({
                    title: "Error",
                    text: "Something went wrong. Please try again.",
                    type: "error"
                });
            }
        });
    }

    function loadStates()
    {
        $.ajax({
            url: "https://shebox.wcd.gov.in/getStates",
            type: "GET",
            dataType: "json",
            success: function(response)
            {
                var html = '<option value="">-- Select State --</option>';

                $.each(response, function(index, row){

                    html += '<option value="'+row.stcode+'">'+row.stname+'</option>';

                });

                $('#statepleadge').html(html);
            }
        });
    }

    function getDistricts(state_id)
    {
        if(state_id === "")
        {
            $('#district_id_pledge').html('<option value="">-- Select District --</option>');
            return;
        }

        $.ajax({
            url: "https://shebox.wcd.gov.in/getDistricts",
            type: "POST",
            data: { state_id: state_id },
            dataType: "json",
            success: function(response)
            {
                console.log("District response:", response);

                var html = '<option value="">-- Select District --</option>';

                $.each(response, function(i, row){
                    html += '<option value="'+row.dtcode+'">'+row.dtname+'</option>';
                });

                $('#district_id_pledge').html(html);
            },
            error: function(xhr){
                console.log("District error:", xhr.responseText);
            }
        });
    }
</script>



