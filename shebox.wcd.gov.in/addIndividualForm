<script>
$(document).ready(function () {

    var $accessBtn = $('.accessibility-btn');
    var $panel = $('#accessibilityPanel');
    var $closeBtn = $('.accessibility-close');

    var lastFocusedElement = null;


    /* =====================================================
       OPEN ACCESSIBILITY PANEL
    ===================================================== */

    $accessBtn.on('click', function (e) {

        e.preventDefault();

        lastFocusedElement = this;

        $panel
            .addClass('is-open')
            .attr('aria-hidden', 'false');

        $accessBtn.attr('aria-expanded', 'true');

        /* Move keyboard focus inside panel */
        setTimeout(function () {
            $closeBtn.focus();
        }, 50);

    });


    /* =====================================================
       CLOSE FUNCTION
    ===================================================== */

    function closeAccessibilityPanel() {

        $panel
            .removeClass('is-open')
            .attr('aria-hidden', 'true');

        $accessBtn.attr('aria-expanded', 'false');

        /* Return focus to accessibility button */
        if (lastFocusedElement) {
            $(lastFocusedElement).focus();
        }

    }


    /* =====================================================
       CLOSE BUTTON
    ===================================================== */

    $closeBtn.on('click', function () {

        closeAccessibilityPanel();

    });


    /* =====================================================
       ESCAPE KEY
    ===================================================== */

    $(document).on('keydown', function (e) {

        if (e.key === 'Escape' || e.keyCode === 27) {

            if ($panel.hasClass('is-open')) {

                e.preventDefault();

                closeAccessibilityPanel();

            }

        }

    });


    /* =====================================================
       FOCUS TRAP
    ===================================================== */

    $panel.on('keydown', function (e) {

        if (e.key !== 'Tab' && e.keyCode !== 9) {
            return;
        }


        var $focusable = $panel.find(
            'button:not([disabled]),' +
            '[href]:not([disabled]),' +
            'input:not([disabled]),' +
            'select:not([disabled]),' +
            'textarea:not([disabled]),' +
            '[tabindex]:not([tabindex="-1"])'
        );


        var firstElement = $focusable[0];

        var lastElement = $focusable[$focusable.length - 1];


        /* Shift + Tab */

        if (e.shiftKey) {

            if (document.activeElement === firstElement) {

                e.preventDefault();

                lastElement.focus();

            }

        }


        /* Normal Tab */

        else {

            if (document.activeElement === lastElement) {

                e.preventDefault();

                firstElement.focus();

            }

        }

    });

});
</script>

  
